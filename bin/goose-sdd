#!/usr/bin/env -S deno run -A

// deno-lint-ignore no-unversioned-import
import * as path from "jsr:@std/path";
// deno-lint-ignore no-unversioned-import
import * as yaml from "jsr:@std/yaml";
// deno-lint-ignore no-unversioned-import
import * as collections from "jsr:@std/collections";
// deno-lint-ignore no-unversioned-import
import * as fs from "jsr:@std/fs";
import { parseArgs } from "jsr:@std/cli/parse-args";

const env = Deno.env.toObject();

const projectName = path.basename(Deno.cwd());
const currentPath = path.fromFileUrl(import.meta.url);
const currentDir = path.dirname(currentPath);
const recipeDir = path.join(currentDir, '..', 'recipes');
const userConfigTop = env.XDG_CONFIG_HOME || path.join(env.HOME, "/.config");
const userConfigDir = path.join(userConfigTop, 'goose-sdd');

const cacheConfigTop = env.XDG_CACHE_HOME || path.join(env.HOME, "/.cache");
const cacheConfigDir = path.join(cacheConfigTop, 'goose-sdd');

const defaultProvider = env.GOOSE_PROVIDER;
const defaultModel = env.GOOSE_MODEL;
const documentProvider = env.GOOSE_SDD_DOCUMENT_PROVIDER || env.GOOSE_LEAD_PROVIDER || defaultProvider;
const documentModel = env.GOOSE_SDD_DOCUMENT_MODEL || env.GOOSE_LEAD_MODEL || env.GOOSE_MODEL || 'default';
const codingProvider = env.GOOSE_SDD_CODING_PROVIDER || env.GOOSE_PROVIDER;
const codingModel = env.GOOSE_SDD_CODING_MODEL || defaultModel || 'default';

async function createMergedYaml(baseYamlPath: string, userYamlPath: string, outputYamlPath: string) {
  try {
    const baseText = await Deno.readTextFile(baseYamlPath);
    const userText = await Deno.readTextFile(userYamlPath);
    const data1 = yaml.parse(baseText) as Record<string, unknown>;
    const data2 = yaml.parse(userText) as Record<string, unknown>;

    const mergedData = collections.deepMerge(data1, data2, { arrays: "replace" });
    await Deno.writeTextFile(outputYamlPath, yaml.stringify(mergedData));
  } catch (error) {
    const e = error as Error;
    throw new Error(`YAML Merge Error (${baseYamlPath}, ${userYamlPath}): ${e.message}`);
  }
}

async function runGooseRecipe(type: string, recipeYamlPath: string, interactive: boolean, sessionName?: string, extraOptions?: string[]): Promise<number> {
  const args = ["run"];
  if (type === "document") {
    args.push("--provider", documentProvider, "--model", documentModel);
  } else if (type === "coding") {
    args.push("--provider", codingProvider, "--model", codingModel);
  }

  if (sessionName) {
    args.push("--name", sessionName);
  } else {
    args.push("--no-session");
  }

  args.push("--recipe", recipeYamlPath);

  if (interactive) {
    args.push("--interactive");
  }

  if (extraOptions) {
    args.push(...extraOptions);
  }

  const command = new Deno.Command("goose", {
    args: args,
    stdin: "inherit",
    stdout: "inherit",
    stderr: "inherit",
  });
  const { code } = await command.output();
  return code;
}

async function setup() {
  const subcommandNames = [
    ["system", ["init", "background", "concept", "architecture", "rule", "glossary"]],
    ["feature", ["init", "requirement", "design", "test", "code", "review"]],
    ["implement", ["init", "requirement", "approach", "test", "code", "review"]],
    ["tool", ["ask"]],
  ] as const;

  for (const [command, subcommands] of subcommandNames) {
    Deno.mkdirSync(`${userConfigDir}/recipes/${command}`, { recursive: true });
    Deno.mkdirSync(`${cacheConfigDir}/recipes/${command}`, { recursive: true });

    for (const subcommand of subcommands) {
      const filePath = `${userConfigDir}/recipes/${command}/${subcommand}.extension.yaml`;
      if (await fs.exists(filePath)) continue;

      const yamlText = await Deno.readTextFile(`${recipeDir}/${command}/${subcommand}.yaml`);
      const json = yaml.parse(yamlText) as Record<string, unknown>;
      if (json["extensions"]) {
        await Deno.writeTextFile(filePath, yaml.stringify({ extensions: json["extensions"] }));
      }
    }
  }
}

type RecipeType = "document" | "coding";

interface CommandConfig {
  step?: string; // Workflow execution order (e.g., "01", "02")
  name: string; // The flag name, e.g., "init", "background"
  type: RecipeType;
  interactive: boolean;
  getExtraOptions?: (positionalArgs: string[]) => string[];
  customHandler?: (positionalArgs: string[]) => Promise<boolean>;
}

// Map parsed flags to find which subcommand the user requested
async function handleGroupCommand(groupName: string, parsedFlags: Record<string, any>, positionalArgs: string[], configs: CommandConfig[]) {
  // Find which configuration flag is present in the parsed flags
  const config = configs.find((c) => parsedFlags[c.name] === true);

  const help = () => {
    console.log(`Usage: goose-sdd --${groupName} [OPTIONS] [ARGS...]`);
    console.log("Workflow Steps (Options):");
    configs.forEach((c) => {
      let desc = `  `;
      if (c.step) {
        desc += `${c.step}: `;
      }
      desc += `--${c.name}`;
      if (groupName === "feature" && c.name !== "list") desc += " <feature_name>";
      console.log(desc);
    });
  };

  if (!config) {
    if (parsedFlags.help || parsedFlags.h) {
      help();
      return;
    }
    console.error(`Error: No valid action flag provided for --${groupName}.`);
    help();
    return;
  }

  if (config.customHandler) {
    const handled = await config.customHandler(positionalArgs);
    if (handled) return;
  }

  const extensionYaml = path.join(userConfigDir, `recipes/${groupName}`, `${config.name}.extension.yaml`);
  const cacheYaml = path.join(cacheConfigDir, `recipes/${groupName}/${config.name}.yaml`);
  await createMergedYaml(`${recipeDir}/${groupName}/${config.name}.yaml`, extensionYaml, cacheYaml);

  const sessionName = `SDD ${groupName.charAt(0).toUpperCase() + groupName.slice(1)} ${config.name}: ${projectName}`;
  const extraOptions = config.getExtraOptions ? config.getExtraOptions(positionalArgs) : [];

  await runGooseRecipe(config.type, cacheYaml, config.interactive, sessionName, extraOptions);
}

async function main() {
  const flags = parseArgs(Deno.args, {
    boolean: [
      "setup", "system", "feature", "implement", "tool", "version", "help",
      // Action flags across all groups
      "init", "background", "concept", "architecture", "rule", "glossary",
      "requirement", "design", "test", "code", "review", "list", "approach", "ask"
    ],
    alias: {
      "system": "s",
      "feature": "f",
      "implement": "i", // note: -i is implement here (group level).
      "tool": "t",
      "version": "v",
      "help": "h",
      "background": "b",
      "concept": "c",
      "architecture": "a",
      "rule": "r",
      "glossary": "g",
      "design": "d",
      "list": "l",
    },
  });

  const positionalArgs = flags._.map(String);

  if (flags.setup) {
    await setup();
    console.log(`If necessary, please add additional settings in "${userConfigDir}".`);
    return;
  }

  if (flags.version) {
    console.log('0.2.1');
    return;
  }

  if (flags.system) {
    const configs: CommandConfig[] = [
      { step: "01", name: "init", type: "document", interactive: false, getExtraOptions: (a) => ["--params", `language=${a[0] || "ja"}`] },
      { step: "02", name: "background", type: "document", interactive: true },
      { step: "03", name: "concept", type: "document", interactive: true },
      { step: "04", name: "architecture", type: "document", interactive: true },
      { step: "05", name: "rule", type: "document", interactive: true },
      { step: "06", name: "glossary", type: "document", interactive: true },
    ];
    await handleGroupCommand("system", flags, positionalArgs, configs);
    return;
  }

  if (flags.feature) {
    const configs: CommandConfig[] = [
      { step: "01", name: "init", type: "document", interactive: false, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      { step: "02", name: "requirement", type: "document", interactive: true, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      { step: "03", name: "design", type: "document", interactive: true, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      { step: "04", name: "test", type: "coding", interactive: true, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      { step: "05", name: "code", type: "coding", interactive: true, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      { step: "06", name: "review", type: "coding", interactive: true, getExtraOptions: (a) => ["--params", `feature=${a[0]}`] },
      {
        step: "list", name: "list", type: "document", interactive: false, customHandler: async () => {
          for await (const entry of fs.expandGlob("docs/sdd/*/sdd.yaml")) {
            const pathParts = entry.path.split('/');
            pathParts.pop();
            const featureName = pathParts.pop();
            console.log(`- ${featureName}`);
          }
          return true;
        }
      },
    ];
    await handleGroupCommand("feature", flags, positionalArgs, configs);
    return;
  }

  if (flags.implement) {
    const configs: CommandConfig[] = [
      { step: "01", name: "init", type: "document", interactive: false, getExtraOptions: (a) => ["--params", `language=${a[0] || "ja"}`] },
      { step: "02", name: "requirement", type: "document", interactive: true },
      { step: "03", name: "approach", type: "document", interactive: true },
      { step: "04", name: "test", type: "coding", interactive: true },
      { step: "05", name: "code", type: "coding", interactive: true },
      { step: "06", name: "review", type: "coding", interactive: true },
    ];
    await handleGroupCommand("implement", flags, positionalArgs, configs);
    return;
  }

  if (flags.tool) {
    const configs: CommandConfig[] = [
      { name: "ask", type: "document", interactive: true },
    ];
    await handleGroupCommand("tool", flags, positionalArgs, configs);
    return;
  }

  // Help output if no group is matched
  console.log("Usage: goose-sdd [GROUP_FLAG] [ACTION_FLAG] [ARGS...]");
  console.log("");
  console.log("Groups:");
  console.log("  --setup");
  console.log("  --system(-s)");
  console.log("  --feature(-f)");
  console.log("  --implement(-i)");
  console.log("  --tool(-t)");
  console.log("  --version(-v)");
  console.log("");
  console.log("Example:");
  console.log("  goose-sdd --system --init");
  console.log("  goose-sdd --feature --list");
  console.log("  goose-sdd --feature --code my_feature");
}

await main();
