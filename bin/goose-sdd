async function analyze(args: string[]) {
  function help() {
    console.log("  init(i)");
    console.log("  discover(d)"); //Macroの解析を行う
    console.log("  feature(f) <feature>"); // featureの初期化
    console.log("  gather(g) [sub-recipe] <feature>"); //コード等から解析する
    console.log("    sub-recipe: gather/*");
    console.log("    infrastructure");
    console.log("    codebase-analyzer <feature> [analysis_focus]");
    console.log("  help");
  }

  const subcommands: { [key: string]: string } = {
    "init": "init",
    "i": "init",
    "discover": "discover",
    "d": "discover",
    "feature": "feature",
    "f": "feature",
    "gather": "gather",
    "g": "gather",
    "synthesize": "synthesize",
    "s": "synthesize",
    "elevate": "elevate",
    "e": "elevate",
    "help": "help",
    "h": "help",
  };

  try {
    const subcommand = subcommands[args[0]];
    const cacheYaml = await prepareRecipe("analyze", subcommand);
    const sessionName = `SDD Analyze ${subcommand}: ${projectName}`;

    switch (subcommand) {
      case "init": {
        const language = args[1] || "ja";
        await runGooseRecipe("document", cacheYaml, false, sessionName, [
          "--params",
          `language=${language}`,
        ]);
        break;
      }
      case "discover": {
        await runGooseRecipe("document", cacheYaml, true, sessionName);
        break;
      }
      case "feature": {
        const featureName = args[1];
        await runGooseRecipe("document", cacheYaml, true, sessionName, [
          "--params",
          `feature=${featureName}`,
        ]);
        break;
      }
      case "gather": {
        const featureName = args[1];
        await runGooseRecipe("document", cacheYaml, true, sessionName, [
          "--params",
          `feature=${featureName}`,
        ]);
        break;
      }
      case "help":
      default: {
        help();
        break;
      }
    }
  } catch (_) {
    if (!subcommands[args[0]]) {
      console.error("Error: unknown subcommand");
    }
    help();
  }
}

async function tool(args: string[]) {
  function help() {
    console.log("  ask(a): Product Consultant");
    console.log("  help");
  }

  const subcommands: { [key: string]: string } = {
    "ask": "ask",
    "a": "ask",
    "help": "help",
    "h": "help",
  };

  try {
    const subcommand = subcommands[args[0]];
    const cacheYaml = await prepareRecipe("tool", subcommand);

    switch (subcommand) {
      case "ask": {
        await runGooseRecipe(
          "document",
          cacheYaml,
          true,
          `SDD Tool ask: ${projectName}`,
        );
        break;
      }
      case "help":
      default: {
        help();
        break;
      }
    }
  } catch (_) {
    if (!subcommands[args[0]]) {
      console.error("Error: unknown subcommand");
    }
    help();
  }
}

function help() {
  console.log("--setup");
  console.log("--system <subcommand>");
  console.log("--feature <subcommand>");
  console.log("--implement <subcommand>");
  console.log("--analyze <subcommand>");
  console.log("--tool <subcommand>");
}

const args = Deno.args;
const option = args.shift();
switch (option) {
  case "--setup": {
    await setup();
    console.log(
      `If necessary, please add additional settings in \"${userConfigDir}\".`,
    );
    break;
  }
  case "--system":
  case "-s": {
    await system(args);
    break;
  }
  case "--feature":
  case "-f": {
    await feature(args);
    break;
  }
  case "--implement":
  case "-i": {
    await implement(args);
    break;
  }
  case "--analyze":
  case "-a": {
    await analyze(args);
    break;
  }
  case "--tool":
  case "-t": {
    await tool(args);
    break;
  }
  case "--version":
  case "-v": {
    console.log("0.2.2");
    break;
  }
  default: {
    help();
  }
}
